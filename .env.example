# Token del bot (obligatorio). Pídelo a @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# Opcional: si se define, solo estos IDs podrán usar el bot.
# Sepáralos con coma. Ejemplo: 1234567,7654321
ALLOWED_USER_IDS=

# Opcional: IDs admin (reservado para futuros comandos privilegiados).
ADMIN_IDS=

# Idioma por defecto: es | en
DEFAULT_LANG=es

# Límite por minuto por usuario.
RATE_LIMIT_PER_MIN=30

# Tamaño máximo de archivo aceptado (MB).
MAX_FILE_MB=20

# Base de datos SQLite (ruta).
DB_PATH=./data/ciberbot.db

# Carpeta de reglas YARA (opcional).
YARA_RULES_DIR=./yara_rules

# Métricas Prometheus
METRICS_ENABLED=true
METRICS_PORT=9090

# Nivel de log.
LOG_LEVEL=INFO
